{
    "name": "@atgenevieve/canvas",
    "version": "0.1.0",
    "private": true,
    "description": "Comment on a live web app; Claude gets the element, the source and the steps, and private data stays out of GitHub.",
    "type": "module",
    "exports": {
        "./vite": {
            "types": "./client/src/vite/index.d.mts",
            "default": "./client/src/vite/index.mjs"
        }
    },
    "workspaces": [
        "client",
        "worker"
    ],
    "bin": {
        "canvas": "client/bin/canvas.mjs"
    },
    "scripts": {
        "prepare": "node scripts/install-hooks.mjs",
        "typecheck": "tsc -p worker --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p client --noEmit && tsc -p examples/basic --noEmit",
        "lint": "eslint .",
        "build:board": "node scripts/build-board.mjs",
        "test": "vitest run",
        "pii": "node scripts/pii-guard.mjs --all"
    },
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "@babel/parser": "7.29.9",
        "magic-string": "0.30.21"
    },
    "peerDependencies": {
        "vite": "^7.0.0 || ^8.0.0"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20260928.1",
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.0.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.11.0",
        "globals": "^17.12.0",
        "miniflare": "5.20260926.0-alpha",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.1",
        "vitest": "4.1.11"
    }
}
