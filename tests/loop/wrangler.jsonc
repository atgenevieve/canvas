{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    // The canvas Worker as tests/loop.browser.mjs runs it with `wrangler dev`: local D1, R2 and Live, no routes, and
    // GitHub pointed at the test's fake (GITHUB_API and GITHUB_TOKEN are passed with --var). Fictional values only.
    "name": "canvas-loop-test",
    "main": "../../worker/src/worker.ts",
    "compatibility_date": "2026-08-15",
    "workers_dev": true,
    "assets": {
        "directory": "../../worker/public",
        "binding": "ASSETS",
        "run_worker_first": true,
        "html_handling": "none",
        "not_found_handling": "none"
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "canvas-loop-test",
            "database_id": "00000000-0000-0000-0000-000000000000",
            "migrations_dir": "../../worker/migrations"
        }
    ],
    "r2_buckets": [{ "binding": "FILES", "bucket_name": "canvas-loop-test-files" }],
    "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "Live" }] },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Live"] }],
    "vars": {
        "BASE_PATH": "/__canvas",
        "PROJECT": "canvas-example",
        "GITHUB_REPO": "owner/canvas-example",
        "INBOX_PR": "7",
        "GITHUB_APP_ID": ""
    }
}
