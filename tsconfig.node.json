{
    // Everything that runs in Node: the tests (on Miniflare), the CLI (JavaScript, checked through its JSDoc), the
    // scripts and the configs.
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "lib": ["ES2023"],
        "types": ["node"],
        "allowJs": true,
        "checkJs": true
    },
    "include": ["worker/test", "worker/src/github-app.ts", "client", "scripts", "*.config.ts", "*.config.js"],
    // The browser side has its own config (client/tsconfig.json).
    "exclude": ["client/src/overlay", "client/test/overlay", "client/test/recorder.test.ts", "client/test/shots.browser.mjs", "client/test/overlay.browser.mjs", "client/src/board", "client/test/board", "client/test/board.browser.mjs"]
}
