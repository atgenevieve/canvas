{
    "$schema": "../node_modules/wrangler/config-schema.json",
    // A template: the canvas Worker for one project. Each project deploys its own, next to the app, from a copy of this
    // file in its own repo (docs/SETUP.md says how, with the paths pointed into node_modules/@atgenevieve/canvas/worker).
    // Every name below is a placeholder: my-app, preview.example.org and example.org stand for the project, its preview
    // host and its zone. In this repo, `npx wrangler dev` runs it locally as it is.
    "name": "my-app-canvas",
    "main": "src/worker.ts",
    "compatibility_date": "2026-08-15",
    // No workers.dev or preview address: the route below, behind Cloudflare Access, is the only way in.
    "workers_dev": false,
    "preview_urls": false,
    // The canvas sits on the app's own host, under /__canvas/, so the overlay in the app calls it on its own origin.
    // Add a route for each host that should have it (the preview host, a test host). BASE_PATH below must match.
    "routes": [{ "pattern": "preview.example.org/__canvas/*", "zone_name": "example.org" }],
    // The canvas page, deployed with the Worker. Every request goes through the Worker first: it turns away any request
    // Access didn't let through.
    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": true,
        "html_handling": "none",
        "not_found_handling": "none"
    },
    // Threads and comments (`npx wrangler d1 create my-app-canvas`, which prints the id to put here).
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "my-app-canvas",
            "database_id": "00000000-0000-0000-0000-000000000000",
            "migrations_dir": "migrations"
        }
    ],
    // Screenshots, from a later step; nothing uses it yet (`npx wrangler r2 bucket create my-app-canvas-files`).
    "r2_buckets": [{ "binding": "FILES", "bucket_name": "my-app-canvas-files" }],
    "vars": {
        // where the routes above put the canvas on the host
        "BASE_PATH": "/__canvas",
        // the project's name, as the inbox message shows it
        "PROJECT": "my-app",
        // The GitHub inbox: each comment a person writes is announced on this pull request (INBOX_PR, its number), as a
        // pointer with no private data, for Claude. It's posted with the GITHUB_TOKEN secret (a fine-grained token for
        // this repository that can write pull requests), or else by a GitHub App: GITHUB_APP_ID here and its private
        // key as the GITHUB_APP_KEY secret. With neither, comments are only saved.
        "GITHUB_REPO": "owner/my-app",
        "INBOX_PR": "",
        "GITHUB_APP_ID": ""
    },
    "observability": { "enabled": true }
}
